# Internal server for the terraform-wiki container. Plain HTTP on :80;
# TLS and the public hostname are the edge Caddy's job (reverse_proxy wiki:80).
{
	auto_https off
}

:80 {
	root * /srv
	encode
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}

	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header /pagefind/* Cache-Control "public, max-age=3600"
}
